# ============================================
# .env.example — 環境変数テンプレート
# ============================================
# このファイルは Git 管理対象。実際の値を入れた .env は .gitignore で除外する。
# 使い方:
#   1. このファイルをコピーして .env を作成: cp .env.example .env
#   2. .env に実際の値を記入
#   3. .env は絶対にコミットしない（.gitignore で除外済）
#
# CLAUDE.md セクション 15-2-A の機密情報漏洩防止ルールに従うこと。
# 詳細は OPERATIONS.md / CLAUDE.md デプロイ前チェックリスト参照。
# ============================================

# --------------------------------------------
# データベース設定（MySQL）
# --------------------------------------------
DATABASE_URL=mysql2://recipe_user:CHANGE_ME@localhost:3306/recipe_board_development
DATABASE_USERNAME=recipe_user
DATABASE_PASSWORD=CHANGE_ME
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=recipe_board_development
DATABASE_NAME_TEST=recipe_board_test

# MySQL の root パスワード（docker-compose 用）
MYSQL_ROOT_PASSWORD=CHANGE_ME

# --------------------------------------------
# Rails 設定
# --------------------------------------------
# Rails 環境（development / test / production）
RAILS_ENV=development

# Rails のシークレットキー（本番では必ず変更）
# 生成: bundle exec rails secret
SECRET_KEY_BASE=CHANGE_ME_TO_GENERATED_SECRET

# Rails のホスト設定（複数可・カンマ区切り・production で host_authorization に使用）
# 例: localhost,127.0.0.1（開発）/ 54.150.151.67,recipe-board.example.com（本番 EC2）
RAILS_HOSTS=localhost,127.0.0.1

# --------------------------------------------
# Rails サーバー / Puma 設定（production で参照・任意）
# --------------------------------------------
# ログレベル（debug / info / warn / error / fatal / unknown）
# config/environments/production.rb が参照。未設定時は info。
# RAILS_LOG_LEVEL=info

# Puma スレッド数（config/puma.rb が参照。未設定時は 3）
# RAILS_MAX_THREADS=3

# Puma ワーカープロセス数（config/puma.rb が参照。0 で single mode）
# WEB_CONCURRENCY=2

# Puma が listen するポート（config/puma.rb が参照。未設定時は 3000）
# PORT=3000

# Puma の PID ファイル出力先（config/puma.rb が参照）
# PIDFILE=tmp/pids/server.pid

# --------------------------------------------
# フロントエンド（Nuxt）設定
# --------------------------------------------
# Nuxt がランタイムで参照する API ベース URL（frontend/nuxt.config.ts が参照）
# /api プレフィックスを含めること（画面設計書で /api/recipes 等と確定済）。
# 値は nuxt.config.ts のフォールバックと一致させる。
NUXT_PUBLIC_API_BASE=http://localhost:3000/api

# --------------------------------------------
# CORS 設定（task-board 由来の教訓: 環境変数化必須）
# --------------------------------------------
# 許可するフロントエンドのオリジン（複数可・カンマ区切り）
# 例: 開発時は localhost、本番は EC2 IP / FQDN を追加
CORS_ALLOWED_ORIGINS=http://localhost:3001

# --------------------------------------------
# AWS 関連（Phase 4 デプロイ時に使用）
# --------------------------------------------
# AWS_REGION=ap-northeast-1
# AWS_ACCESS_KEY_ID=                    # 通常はインスタンスロールを使うので不要
# AWS_SECRET_ACCESS_KEY=                # 通常はインスタンスロールを使うので不要

# --------------------------------------------
# その他のサードパーティ API
# --------------------------------------------
# 例: 画像アップロード用の S3 / 検索用の外部 API キー等を追加予定
