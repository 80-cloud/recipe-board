# ============================================
# terraform.tfvars.example — 値の雛形（B-5-δ）
# ============================================
# 使い方:
#   1. このファイルを terraform.tfvars としてコピー
#        cp terraform.tfvars.example terraform.tfvars
#   2. 各値を実値に置き換え（CHANGE_ME を残さない）
#   3. terraform.tfvars は infra/.gitignore で除外済み（コミットされない）
#
# 重要（incident-library 反映）:
#   - 機密値の placeholder は CHANGE_ME 形式を使用
#     （gitleaks allowlist に含まれており、誤検知されない）
#   - 実値に置き換える際、低エントロピー値（"password", "admin" 等）は使わない
#     （task-board 2026-05-07 hardcoded-password 同型事故の予防）
#   - 値の書式は variables.tf の description と整合させる
#     （recipe-board 2026-05-08 env-example-value-drift 同型事故の予防）
# ============================================

# ----- 必須値 5 件 -----

# 自宅 IPv4 CIDR（SSH 許可元）
# 取得: curl -4 https://checkip.amazonaws.com を実行して /32 を付ける
# 書式: "x.x.x.x/32"（例: "203.0.113.10/32"）
home_ipv4_cidr = "CHANGE_ME"

# 自宅 IPv6 CIDR（SSH 許可元）
# 取得: curl -6 https://checkip.amazonaws.com を実行して /64 を付ける
# 書式: "xxxx:xxxx:xxxx:xxxx::/64"（例: "2001:db8:1234:5678::/64"）
# IPv6 が無い環境では "::1/128"（loopback）を入れて事実上無効化可
home_ipv6_cidr = "CHANGE_ME"

# EC2 SSH 用 Key Pair 名（事前に AWS Console / CLI で作成済みのもの）
# 確認: aws ec2 describe-key-pairs --query 'KeyPairs[].KeyName'
# 書式: 文字列（例: "recipe-board-key"）
ec2_key_name = "CHANGE_ME"

# RDS マスターユーザー名
# 書式: 1〜16 文字の英数字（mysql 制限）。"admin" / "root" 等の予約語は不可
db_username = "CHANGE_ME"

# RDS マスターパスワード
# 書式: 8 文字以上、英数字 + 記号推奨。"password" / "admin" 等の弱パスワードは不可
# 生成例: openssl rand -base64 24
db_password = "CHANGE_ME"

# ----- 任意値 3 件（default あり、上書き不要なら削除可）-----

# AWS リージョン（default: ap-northeast-1）
# aws_region = "ap-northeast-1"

# プロジェクト名（default: recipe-board）
# project_name = "recipe-board"

# EC2 インスタンスタイプ（default: t3.micro）
# 注意: ap-northeast-1 では t3.micro のみ無料枠。validation で他値は拒否される
# ec2_instance_type = "t3.micro"
