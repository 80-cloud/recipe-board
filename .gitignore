# ============================================
# macOS
# ============================================
.DS_Store
.AppleDouble
.LSOverride

# Finder / iCloud Drive 等が自動生成する複製ファイル
# 例: "main 2.tf" "incident 3.md"
# cwd-branch state 系事故の副産物として発生する
* [0-9].*
* [0-9]

# ============================================
# エディタ・IDE
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# 機密情報・環境変数（絶対にコミットしない）
# ============================================
.env
.env.*
!.env.example
*.pem
*.key
secrets.yml
master.key
credentials.yml.enc

# ============================================
# Ruby / Rails
# ============================================
/.bundle
/vendor/bundle
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/storage/*
!/storage/.keep
/public/uploads/
/public/assets/
/public/packs/
/public/packs-test/
*.log
.byebug_history
.rspec_status
/db/*.sqlite3
/db/*.sqlite3-journal
/coverage/
/spec/tmp/

# ============================================
# Node.js / Nuxt
# ============================================
node_modules/
.nuxt/
.output/
.nitro/
.cache/
dist/
.data/
.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# ============================================
# Docker
# ============================================
*.pid

# ============================================
